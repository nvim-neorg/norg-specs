document      <- (blank_line / heading / paragraph)*

blank_line    <- indent line_ending

zs            <- [                　]
whitespace    <- (zs / "\t")+
indent        <- (zs / "\t")*

punctuation   <- [!"#$%&'()*+,\-./:;<=>?@\[\]\\^_`{|}~]
line_ending   <- "\r\n" / "\r" / "\n" / "\f"

regular       <- !(whitespace / line_ending / punctuation) .
word          <- regular+

paragraph_segment <- (word / punctuation / whitespace)+

heading_start <- indent "*"+ whitespace
title         <- paragraph_segment

paragraph     <- paragraph_segment (line_ending !heading_start !blank_line paragraph_segment)* line_ending?

heading       <- heading_start title? line_ending?
